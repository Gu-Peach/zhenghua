# Required OpenAI-compatible VLM settings
VLM_MODEL=your-vlm-model
VLM_BASE_URL=http://127.0.0.1:8000/v1
VLM_API_KEY=

# Agent prompts and image-backed Few-shot examples. These paths are optional;
# the defaults point to backend/app/prompts/.
VLM_PAGE_CLASSIFICATION_PROMPT_PATH=backend/app/prompts/page_classification.md
VLM_PAGE_SCAN_PROMPT_PATH=backend/app/prompts/page_scan_index.md
VLM_PAGE_CLASSIFICATION_FEW_SHOT_IMAGES=true
VLM_PAGE_CLASSIFICATION_FEW_SHOT_EXAMPLES_DIR=backend/app/prompts/examples_page_classification
VLM_PAGE_SCAN_FEW_SHOT_IMAGES=true
VLM_PAGE_SCAN_FEW_SHOT_EXAMPLES_DIR=backend/app/prompts/examples_page_scan_index

# Runtime controls
VLM_PDF_RENDER_DPI=300
VLM_CONCURRENCY=2
VLM_TIMEOUT_SECONDS=600
VLM_RETRY_COUNT=2
VLM_MAX_PDF_PAGES=0
VLM_OUTPUT_MODE=library

# Legacy import workbook used for wiring-table-import.xls/.xlsx.
VLM_IMPORT_XLS_TEMPLATE_PATH=case/放线表导入格式(1).xls

# Optional JSON overrides; values must stay in the closed vocabulary below.
# VLM_TERMINAL_STRIP_MAP={"XD0":"X0"}
