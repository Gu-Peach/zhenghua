# OpenAI-compatible VLM config
VLM_MODEL=your-vlm-model
VLM_BASE_URL=http://3stooges.chat:4088
VLM_API_KEY=your-api-key

# Optional. Use this only if your provider's endpoint is not /v1/chat/completions.
# VLM_CHAT_COMPLETIONS_URL=http://3stooges.chat:4088/v1/chat/completions

# Optional runtime config
VLM_TIMEOUT_SECONDS=300
VLM_MAX_PDF_PAGES=50
VLM_CONCURRENCY=1
VLM_IMAGE_BATCH_SIZE=4
VLM_GROUPING_IMAGE_BATCH_SIZE=8
# 300 DPI is intentional: drawing labels are small.
VLM_PDF_RENDER_DPI=300
# Legacy override, if needed: VLM_PDF_RENDER_SCALE=4.1667
# VLM_LIBRARY_ROOT=frontend/public/library
VLM_USE_RESPONSE_FORMAT=false

# LangGraph V1 segmentation
VLM_SEGMENT_CONCURRENCY=4
VLM_SEGMENT_RETRY_COUNT=1
VLM_MAX_SEGMENT_PAGES=20
VLM_KEEP_TEMP_IMAGES=false
VLM_OUTPUT_MODE=library
# VLM_SEGMENT_PROMPT_PATH=backend/app/prompts/segment_decision.md
VLM_SEGMENT_FEW_SHOT_IMAGES=true
# VLM_SEGMENT_FEW_SHOT_EXAMPLES_DIR=backend/app/prompts/example_segment
# Optional JSON override, merged with the defaults in app/core/config.py.
# VLM_TERMINAL_STRIP_MAP={"XD3":"X3","XD4":"X4"}

# Multimodal few-shot extraction. Enabled by default; examples include drawing images + expected JSON.
VLM_FEW_SHOT_IMAGES=true
# VLM_FEW_SHOT_EXAMPLES_DIR=backend/app/prompts/examples_extration

# Reasoning models such as Qwen3 think before answering by default, which can
# take many minutes on large drawings. false disables it via chat_template_kwargs
# (vLLM / SGLang). Leave empty for providers that reject unknown parameters.
VLM_ENABLE_THINKING=false

# Optional cap on generated tokens. Leave empty to use the provider default.
# VLM_MAX_TOKENS=16384

# Local Supabase. Keep the service-role key on the backend only.
SUPABASE_ENABLED=false
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
SUPABASE_STORAGE_BUCKET=images
